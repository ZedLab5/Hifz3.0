<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include Room Database -->
    <include domain="database" path="noor_database.db" />
    <include domain="database" path="noor_database.db-wal" />
    <include domain="database" path="noor_database.db-shm" />

    <!-- Include Persistent SharedPreferences -->
    <include domain="sharedpref" path="noor_app_preferences.xml" />
    <include domain="sharedpref" path="noor_user_prefs.xml" />

    <!-- Exclude large downloaded audio files (>25MB Auto Backup limit) -->
    <exclude domain="file" path="quran_audio" />

    <!-- Exclude custom user media files -->
    <exclude domain="file" path="custom_adhan.mp3" />

    <!-- Exclude ephemeral runtime logs and crash tracker -->
    <exclude domain="sharedpref" path="noor_reliability_prefs.xml" />
    <exclude domain="sharedpref" path="noor_prefs.xml" />
</full-backup-content>
